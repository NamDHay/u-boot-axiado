		};

		spi5: spi@33390000 {
			compatible = "snps,dwc-ssi-1.01a";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x33390000 0x0 0x10000>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 119 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&spi_clk>;
			num-cs = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		spi6: spi@333a0000 {
			compatible = "snps,dwc-ssi-1.01a";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x333a0000 0x0 0x10000>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 120 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&spi_clk>;
			num-cs = <1>;
			reg-io-width = <4>;
			status = "disabled";
		};

        /* HCP (Header and Crypto Processing Engine) */
		hcp: hcp@43100000 {
			compatible = "axiado,ax3000-hcp";
			#address-cells = <1>;
			#size-cells = <0>;
			status = "okay";
			/*
			 * Memory regions for the HCP subsystem:
			 * - SHIM registers
			 * - PHY CSR
			 */
			reg = <0x0 0x43100000 0x0 0x4000>,    /* SHIM regs (16KB) */
			      <0x0 0x47000000 0x0 0x50000>,   /* PHY CSR (320KB) */
			      <0x0 0x33120800 0x0 0x200>;   /* IOCTL regs */
			reg-names = "shim", "phy-csr", "ioctl";

			/* MAC 0: 10G RXAUI */
			mac0: mac@0 {
				compatible = "axiado,ax3000-mac";
				reg = <0>;
				phy-mode = "rxaui";
				status = "disabled";
			};

			/* MAC 1: 1G SGMII */
			mac1: mac@1 {
				compatible = "axiado,ax3000-mac";
				reg = <1>;
				phy-mode = "sgmii";
				status = "disabled";
			};

			/* MAC 2: 1G SGMII */
			mac2: mac@2 {
				compatible = "axiado,ax3000-mac";
				reg = <2>;
				phy-mode = "sgmii";
				status = "disabled";
			};

			/* MAC 3: 1G SGMII */
			mac3: mac@3 {
				compatible = "axiado,ax3000-mac";
				reg = <3>;
				phy-mode = "sgmii";
				status = "disabled";
			};

			/* MAC 4: 1G SGMII */
			mac4: mac@4 {
				compatible = "axiado,ax3000-mac";
				reg = <4>;
				phy-mode = "sgmii";
				status = "disabled";
			};

			/* MDIO bus for PHY management */
			mdio: mdio {
				compatible = "axiado,ax3000-mdio";
				#address-cells = <1>;
				#size-cells = <0>;
			};

			hfifo: hfifo {
				compatible = "axiado,ax3000-hfifo";
				mac = <1>;
				status = "okay";
			};
		};

        pcie_x1: pcie@45200000 {
            compatible = "axiado,ax3005-pcie";
            status = "disable";
            device_type = "pci";
            device_class = "host";
            device_role = "host";                   /* Host bridge Controller */
            reg = <0 0x45200000 0 0x1000>,          /* PADS XPA reg */
                    <0 0x45300000 0 0x4000>,        /* AFI PHY reg */
                    <0 0x45203000 0 0x1000>,        /* int cfg space */
                    <0 0x45202000 0 0x1000>,        /* bridge reg */
                    <0 0x45280000 0 0x8000>,        /* MBX reg */
                    <0 0x45240000 0 0x1000>,        /* EXT reg */
                    <0 0x33202400 0 0x100>;		    /* IOCTL reg */
            reg-names = "csr", "phy", "cfg", "bridge", "mbx", "ext", "ioctl";
            #address-cells = <3>;
            #size-cells = <2>;
            num-lanes = <1>;
            clocks = <&uartclk>;
            clock-names = "uartclk";
            bus-range = <0x00 0x0f>;

            /* PCI Host bridge Device */
            ranges = <0x83000000 0x0 0x00000000 0x7 0x00000000 0x0 0x10000000>,    /* Non-Prefetchable MEM */
                     <0xc3000000 0x0 0x40000000 0x7 0x40000000 0x0 0x10000000>;    /* Prefetchable MEM */

            /* Bellow config only for pcie RP */
            pci@1,0 {
                device_type = "pci";
                /* Bus 1, device 0, function 0 */
                assigned-addresses = <0x83010000 0x7 0xE0000000 0x0 0x400000>;
                reg = <0x10000 0 0 0 0>; /* Bus 1, device 0, function 0 */
                #address-cells = <3>;
                #size-cells = <2>;
                ranges;
            };
        };

        pcie_x2: pcie@45000000 {
            compatible = "axiado,ax3005-pcie";
            status = "disable";
            device_type = "pci";
            device_class = "host";
            device_role = "host";                   /* Host bridge Controller */
            reg = <0 0x45000000 0 0x1000>,          /* PADS XPA reg */
                    <0 0x45100000 0 0x4000>,        /* AFI PHY reg */
                    <0 0x45003000 0 0x1000>,        /* int cfg space */
                    <0 0x45002000 0 0x1000>,        /* bridge reg */
                    <0 0x45080000 0 0x8000>,        /* MBX reg */
                    <0 0x45040000 0 0x1000>,        /* EXT reg */
                    <0 0x33202400 0 0x100>;         /* IOCTL reg */
            reg-names = "csr", "phy", "cfg", "bridge", "mbx", "ext", "ioctl";
            #address-cells = <3>;
            #size-cells = <2>;
            num-lanes = <2>;
            clocks = <&uartclk>;
            clock-names = "uartclk";
            bus-range = <0x00 0xff>;

            /* PCI Host bridge Device */
            ranges = <0x83000000 0x0 0x00000000 0x5 0x00000000 0x0 0x10000000>,    /* Non-Prefetchable MEM */
                     <0xc3000000 0x0 0x40000000 0x5 0x40000000 0x0 0x10000000>;    /* Prefetchable MEM */

            /* Bellow config only for pcie RP */
            pci@1,0 {
                device_type = "pci";
                /* Bus 1, device 0, function 0 */
                assigned-addresses = <0x83020000 0x5 0xE0000000 0x0 0x400000>;
                reg = <0x20000 0 0 0 0>; /* Bus 1, device 0, function 0 */
                #address-cells = <3>;
                #size-cells = <2>;
                ranges;
            };
        };

        rtc0: rtc@33282000 {
            compatible = "cdns,rtc-r109v3";
            reg = <0x00 0x33282000 0x00 0x100>;
            clock-names = "pclk", "refclk";
            clocks = <&pclk &rtcclk>;
            interrupt-parent = <&gic500>;
            interrupts = <GIC_SPI 109 IRQ_TYPE_LEVEL_HIGH>;
            status = "disabled";
        };

        usb2_0: usb@41000000 {
            compatible = "axiado,ax3000-gen2-xhci", "generic-xhci";
            reg = <0x00 0x41000000 0x00 0x100000>;
            interrupt-parent = <&gic500>;
            interrupts = <GIC_SPI 19 IRQ_TYPE_LEVEL_HIGH>;
            status = "disabled";
        };

        usb2_1: usb@41100000 {
            compatible = "axiado,ax3000-gen2-xhci", "generic-xhci";
            reg = <0x00 0x41100000 0x00 0x100000>;
            interrupt-parent = <&gic500>;
            interrupts = <GIC_SPI 20 IRQ_TYPE_LEVEL_HIGH>;
            status ="disabled";
        };

        usb2_2: usb@41200000  {
            compatible = "axiado,ax3000-udc";
            reg = <0x00 0x41200000 0x00 0x100000>;
            interrupt-parent = <&gic500>;
            interrupts = <GIC_SPI 21 IRQ_TYPE_LEVEL_HIGH>;
            status = "disabled";
        };

        usb2_3: usb@41300000  {
            compatible = "axiado,ax3000-udc";
            reg = <0x00 0x41300000 0x00 0x100000>;
            interrupt-parent = <&gic500>;
            interrupts = <GIC_SPI 22 IRQ_TYPE_LEVEL_HIGH>;
            status = "disabled";
        };

        usb3_0: usb@41400000 {
            compatible = "axiado,ax3000-gen3-xhci", "generic-xhci";
            reg = <0x00 0x41400000 0x00 0x100000>;
            interrupt-parent = <&gic500>;
            interrupts = <GIC_SPI 17 IRQ_TYPE_LEVEL_HIGH>;
            status = "disabled";
        };

        usb3_1: usb@41500000 {
            compatible = "axiado,ax3000-gen3-xhci", "generic-xhci";
            reg = <0x00 0x41500000 0x00 0x100000>;
            interrupt-parent = <&gic500>;
            interrupts = <GIC_SPI 18 IRQ_TYPE_LEVEL_HIGH>;
            status = "disabled";
        };

        disp_ctrl: disp_ctrl@40c00000 {
            compatible = "axiado,drm-db9000";
            reg = <0x0 0x40c00000 0x0 0x1000>;
            /* memory-region = <&pci_ep_ctrl>; */
            clocks = <&refclk>;
            clock-names = "refclk";
            bits-per-pixel = <32>;
            bus-width = <24>;
            paddr-disp = <0x8c000000>;
            status = "disabled";
            disp_out: port {
                #address-cells = <1>;
                #size-cells = <0>;
                disp_out_hdmi: endpoint@0 {
                    reg = <0>;
                    remote-endpoint = <&hdmi_in_disp>;
                };
            };
        };

        hdmi: hdmi@40c11000 {
            compatible ="axiado,ax3000-hdmi";
            reg = <0x00 0x40c11000 0x00 0x4000>;
            /* memory-region = <&pci_ep_ctrl>; */
            clocks = <&refclk>;
            clock-names = "refclk";
            #address-cells = <1>;
            #size-cells = <0>;
            status = "disabled";
            hdmi_in: port@0 {
                #address-cells = <1>;
                #size-cells = <0>;
                hdmi_in_disp: endpoint@0 {
                    reg = <0>;
                    remote-endpoint = <&disp_out_hdmi>;
                };
            };
        };
    };

    video: video {
        compatible = "axiado,ax3000-video";
    };

};

&pinctrl0 {
    /*
    * GPIO Bank 0
    * GPIO_0 ~ GPIO_31
    */

    pinctrl_i2c0_default: i2c0_default {
        function = "I2C0";
        axiado,pins = <0 1>;
