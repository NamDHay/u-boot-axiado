		sdhci0: mmc0@46000000 {
			compatible = "axiado,ax3000-sdhci";
			reg = <0x0 0x46000000 0x00 0x1000>;
			clock-names = "clk_xin", "clk_ahb";
			clocks = <&clk_xin &clk_ahb>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 155 IRQ_TYPE_LEVEL_HIGH>;
			bus-width = <8>;
			phys = <&emmc_phy>;
			phy-names = "phy_arasan";
			status = "disabled";
		};

		saradc:saradc@331A0000 {
			compatible = "axiado,ax3000-saradc";
			reg = <0x00 0x331a0000 0x00 0x400>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 166 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&pclk &pclk>;
			clock-names = "refclk", "refclk";
			#io-channel-cells = <1>;
			status = "disabled";
		};

        spi0: spi@33010000 {
			compatible = "snps,dwc-ssi-1.01a";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x33010000 0x0 0x10000>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_spi0_default>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 115 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&spi_clk>;
			num-cs = <2>;
			reg-io-width = <4>;
			status = "disabled";
		};

		spi1: spi@33090000 {
			compatible = "snps,dwc-ssi-1.01a";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x33090000 0x0 0x10000>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_spi1_default>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 116 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&spi_clk>;
			num-cs = <1>;
			reg-io-width = <4>;
			status = "disabled";
		};

		spi2: spi@333c0000 {
			compatible = "snps,dwc-ssi-1.01a";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x333c0000 0x0 0x10000>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_spi2_default>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 117 IRQ_TYPE_LEVEL_HIGH>;
			clocks = <&spi_clk>;
			num-cs = <1>;
			reg-io-width = <4>;
			status = "disabled";
		};

		spi3: spi@330e0000 {
			compatible = "snps,dwc-ssi-1.01a";
			#address-cells = <1>;
			#size-cells = <0>;
			reg = <0x0 0x330e0000 0x0 0x10000>;
			interrupt-parent = <&gic500>;
