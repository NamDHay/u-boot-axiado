#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>

/memreserve/ 0x80002fa0 0x00000008;

/ {
	aliases {
        serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &uart2;
		serial3 = &uart3;
		serial4 = &uart4;
		serial5 = &uart5;
		serial6 = &uart6;
		serial7 = &uart7;
		serial8 = &uart8;
		i2c0 = &i2c0;
		i2c1 = &i2c1;
		i2c2 = &i2c2;
		i2c3 = &i2c3;
		i2c4 = &i2c4;
		i2c5 = &i2c5;
		i2c6 = &i3c6;
		i2c7 = &i3c7;
		i2c8 = &i3c8;
		i2c9 = &i3c9;
		i2c10 = &i2c10;
		i2c11 = &i2c11;
		i2c12 = &i3c12;
		i2c13 = &i3c13;
		i2c14 = &i2c14;
		i2c15 = &i2c15;
		i2c16 = &i2c16;
		i2c17 = &i2c17;
		i2c18 = &i2c18;
		i2c19 = &i2c19;
		i2c20 = &i2c20;
		i2c21 = &i2c21;
		i2c22 = &i3c22;
		i2c23 = &i2c23;
		i2c24 = &i2c24;
		i2c25 = &i2c25;
		i2c26 = &i2c26;
		i2c27 = &i2c27;
		i2c28 = &i2c28;
		i2c29 = &i2c29;
		i2c30 = &i2c30;
		i2c31 = &i2c31;
		spi0  = &spi0;
		spi1  = &spi1;
		spi2  = &spi2;
		spi3  = &spi3;
		spi5  = &spi5;
		spi6  = &spi6;
	};

	cpus {
		#address-cells = <2>;
		#size-cells = <0>;

		cpu0: cpu@0 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x0>;
			enable-method = "spin-table";
			cpu-release-addr = <0x0 0x80002fa0>;
		};
		cpu1: cpu@1 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x1>;
			enable-method = "spin-table";
			cpu-release-addr = <0x0 0x80002fa0>;
		};
		cpu2: cpu@2 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x2>;
			enable-method = "spin-table";
			cpu-release-addr = <0x0 0x80002fa0>;
		};
		cpu3: cpu@3 {
			compatible = "arm,cortex-a53";
			device_type = "cpu";
			reg = <0x0 0x3>;
			enable-method = "spin-table";
			cpu-release-addr = <0x0 0x80002fa0>;
		};
	};

    reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;
		pci_ep_bar01: buffer@89300000 {
			reg = <0x00 0x89300000 0x00 0x100000>; /* Control-1MB */
			no-map;
		};
		pci_ep_bar23: buffer@8c000000 {
			reg = <0x00 0x8c000000 0x00 0x4000000>; /* Data-64MB framebuffer */
			no-map;
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupt-parent = <&gic500>;
		interrupts = <GIC_PPI 13 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 14 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 11 IRQ_TYPE_LEVEL_LOW>,
			     <GIC_PPI 10 IRQ_TYPE_LEVEL_LOW>;
		clock-frequency = <1000000000>;
	};

	clocks {
		refclk: refclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <125000000>;
		};

		uartclk: uartclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <10000000>;
		};

		pclk: pclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <100000000>; /* 100MHz pclk */
		};

		sysclk: sysclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <200000000>; /* 200MHz sysclk */
		};

		spi_clk: spi_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <400000000>;  /* 400MHz */
		};

		sp_dma_clk: sp_dma_clk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <3125000>;  /* 3.125 MHz */
		};

		clk_mali: clk_mali {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <500000000>; /* 500MHz Clock half of CPU clock*/
			clock-output-names = "clk_mali";
		};

		clk_pclk: clk_pclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <74250000>;
			clock-output-names = "clk_pclk";
		};

		rtcclk: rtcclk {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <1>; /* 1Hz */
		};

		clk_ahb: clk_ahb {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <200000000>;
		};

		clk_xin: clk_xin {
			compatible = "fixed-clock";
			#clock-cells = <0>;
			clock-frequency = <200000000>;
		};
	};

	soc: soc {
		compatible = "simple-bus";
		#address-cells = <2>;
		#size-cells = <2>;
		interrupt-parent = <&gic500>;
		ranges;

		gic500: interrupt-controller@40400000 {
			compatible = "arm,gic-v3";
			#address-cells = <2>;
			#size-cells = <2>;
			ranges;
			#interrupt-cells = <3>;
			interrupt-controller;
			#redistributor-regions = <1>;
			reg = <0x00 0x40400000 0x00 0x10000>, /* GICD */
			      <0x00 0x40500000 0x00 0xc0000>; /* GICR */
			interrupts = <GIC_PPI 9 IRQ_TYPE_LEVEL_HIGH>;
		};

        pinctrl0: pinctrl@33020C00 {
            compatible = "axiado,ax3000-pinctrl";
			reg = <0x00 0x33020C00 0x00 0x200>;
        };

        pinctrl1: pinctrl@33120800 {
            compatible = "axiado,ax3000-pinctrl";
			reg = <0x00 0x33120800 0x00 0x200>;
        };

        pinctrl2: pinctrl@33202400 {
            compatible = "axiado,ax3000-pinctrl";
			reg = <0x00 0x33202400 0x00 0x200>;
        };

        pinctrl3: pinctrl@33302000 {
            compatible = "axiado,ax3000-pinctrl";
			reg = <0x00 0x33302000 0x00 0x200>;
        };

        /* GPIO Controller banks 0 - 7 */
		gpio0: gpio-controller@0x33000000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 183 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33000000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		gpio1: gpio-controller@0x33080000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33080000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		gpio2: gpio-controller@0x33100000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 185 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33100000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		gpio3: gpio-controller@0x33180000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 186 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33180000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		gpio4: gpio-controller@0x33200000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 187 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33200000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		gpio5: gpio-controller@0x33280000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 188 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33280000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		gpio6: gpio-controller@0x33300000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 189 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33300000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

		gpio7: gpio-controller@0x33380000 {
			compatible = "axiado,ax3000-gpio";
			clocks = <&pclk>;
			gpio-controller;
			#gpio-cells = <2>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 190 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-controller;
			reg = <0x00 0x33380000 0x00 0x100>;
			#interrupt-cells = <2>;
			status = "disabled";
		};

        uart0: serial0@33020000 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 112 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33020000 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};

		uart1: serial1@330A0000 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 113 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x330A0000 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};

		uart2: serial2@33120000 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 114 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33120000 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};

		uart3: serial3@33020800 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 170 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33020800 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			bootph-pre-reloc;
			status = "disabled";
		};

		uart4: serial4@331a0400 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 208 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x331a0400 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};

		uart5: serial5@33381D00 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 209 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33381D00 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};

		uart6: serial6@33381E00 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 210 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33381E00 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};

		uart7: serial7@33381F00 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 211 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33381F00 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};

		uart8: serial8@330C0000 {
			compatible = "cdns,uart-r1p12", "xlnx,xuartps";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 212 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x330C0000 0x00 0x100>;
			clock-names = "uart_clk", "pclk";
			clocks = <&refclk &pclk>;
			uart-clk = <10000000>;
			status = "disabled";
		};


		i2c0: i2c@33000400 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 76 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33000400 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c1: i2c@33000800 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 77 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33000800 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c2: i2c@33080400 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 78 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33080400 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c3: i2c@33080800 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 79 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33080800 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c4: i2c@33100400 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 80 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33100400 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c5: i2c@33100800 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 81 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33100800 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i3c6: i2c@33180400 {
			compatible = "cdns,i3c-master";
			clocks = <&pclk &sysclk>;
			clock-names = "pclk", "sysclk";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 82 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-hz = <100000>;
			i3c-scl-hz = <400000>;
			reg = <0x00 0x33180400 0x00 0x400>;
			#address-cells = <3>;
			#size-cells = <0>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_i3c6_default>;
			status = "disabled";
		};

		i3c7: i2c@33180800 {
			compatible = "cdns,i3c-master";
			clocks = <&pclk &sysclk>;
			clock-names = "pclk", "sysclk";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 83 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-hz = <100000>;
			i3c-scl-hz = <400000>;
			reg = <0x00 0x33180800 0x00 0x400>;
			#address-cells = <3>;
			#size-cells = <0>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_i3c7_default>;
			status = "disabled";
		};

		i3c8: i2c@33200400 {
			compatible = "cdns,i3c-master";
			clocks = <&pclk &sysclk>;
			clock-names = "pclk", "sysclk";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 84 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-hz = <100000>;
			i3c-scl-hz = <400000>;
			reg = <0x00 0x33200400 0x00 0x400>;
			#address-cells = <3>;
			#size-cells = <0>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_i3c8_default>;
			status = "disabled";
		};

		i3c9: i2c@33200800 {
			compatible = "cdns,i3c-master";
			clocks = <&pclk &sysclk>;
			clock-names = "pclk", "sysclk";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 85 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-hz = <100000>;
			i3c-scl-hz = <400000>;
			reg = <0x00 0x33200800 0x00 0x400>;
			#address-cells = <3>;
			#size-cells = <0>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_i3c9_default>;
			status = "disabled";
		};

		i2c10: i2c@33280400 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33280400 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c11: i2c@33280800 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 87 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33280800 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i3c12: i2c@33300400 {
			compatible = "cdns,i3c-master";
			clocks = <&pclk &sysclk>;
			clock-names = "pclk", "sysclk";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 88 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-hz = <100000>;
			i3c-scl-hz = <400000>;
			reg = <0x00 0x33300400 0x00 0x400>;
			#address-cells = <3>;
			#size-cells = <0>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_i3c12_default>;
			status = "disabled";
		};

		i3c13: i2c@33300800 {
			compatible = "cdns,i3c-master";
			clocks = <&pclk &sysclk>;
			clock-names = "pclk", "sysclk";
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 89 IRQ_TYPE_LEVEL_HIGH>;
			i2c-scl-hz = <100000>;
			i3c-scl-hz = <400000>;
			reg = <0x00 0x33300800 0x00 0x400>;
			#address-cells = <3>;
			#size-cells = <0>;
            pinctrl-names = "default";
            pinctrl-0 = <&pinctrl_i3c13_default>;
			status = "disabled";
		};

		i2c14: i2c@33380400 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
			interrupts = <GIC_SPI 90 IRQ_TYPE_LEVEL_HIGH>;
			reg = <0x00 0x33380400 0x00 0x400>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2c15: i2c@33380800 {
			compatible = "axiado,ax3000-i2c", "cdns,i2c-r1p14";
			clocks = <&pclk>;
			interrupt-parent = <&gic500>;
