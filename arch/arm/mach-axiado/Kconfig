if ARCH_AXIADO

config SYS_ARCH
	default "arm"

config SYS_SOC
	default "axiado"

choice
	prompt "Axiado SoC select"
	depends on ARCH_AXIADO
	default AXIADO_AX3005

config AXIADO_AX3000
	bool "Support Axiado AX3000 SoC"
	select ARM64
	select ARMV8_SWITCH_TO_EL1
	select DM
	select DM_SERIAL
	select GICV3
	select ZYNQ_SERIAL
	help
	  The Axiado AX3000 SCM3000 is a ARM-based SoC with A53 CPU.
	  It is used as Board Management Controller on many server boards,
	  which is enabled by support of LPC and eSPI peripherals.

config AXIADO_AX3005
	bool "Support Axiado AX3005 SoC"
	select ARM64
	select ARMV8_SWITCH_TO_EL1
	select DM
	select DM_SERIAL
	select GICV3
	select ZYNQ_SERIAL
	help
	  The Axiado AX3005 SCM3005 is a ARM-based SoC with A53 CPU.
	  It is used as Board Management Controller on many server boards,
	  which is enabled by support of LPC and eSPI peripherals.

config AXIADO_MK
	bool "Support Axiado AX3000 running from A53 OCM (mk)"
	select ARM64
	select ARMV8_SWITCH_TO_EL1
	select DM
	select DM_SERIAL
	select GICV3
	select ZYNQ_SERIAL
	help
	  AX3000 (quad-core Cortex-A53) SCM3000 clone whose U-Boot runs
	  entirely from the 1 MiB A53 on-chip SRAM at 0x80200000, without
	  relocation, so it does not need DDR. Diagnostics use the AX3000
	  (A0) register map.

endchoice

source "arch/arm/mach-axiado/scm3000/Kconfig"
source "arch/arm/mach-axiado/scm3005/Kconfig"
source "arch/arm/mach-axiado/mk/Kconfig"

endif
