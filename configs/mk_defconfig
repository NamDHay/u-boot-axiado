CONFIG_ARM=y
CONFIG_ARM64=n
CONFIG_IRQ=y
CONFIG_GICV3=y
CONFIG_GIC_V3_ITS=y
CONFIG_USE_SEPARATE_FAULT_HANDLERS=y
CONFIG_ARCH_AXIADO=y
CONFIG_AXIADO_MK=y
CONFIG_TARGET_MK=y
CONFIG_POSITION_INDEPENDENT=y
# Runs in place from the 1 MiB A53 OCM (0x80200000), no relocation.
CONFIG_TEXT_BASE=0x80200000
CONFIG_SYS_MONITOR_BASE=0x80200000
CONFIG_EXPERT=y
CONFIG_SKIP_RELOCATE=y
# Early stack/gd/malloc_f at a fixed OCM address (CFG_SYS_INIT_RAM_ADDR in mk.h)
# CONFIG_INIT_SP_RELATIVE is not set
# Default load address is in DDR (only usable once DDR is initialised)
CONFIG_SYS_LOAD_ADDR=0x3C100000
CONFIG_SYS_MALLOC_F_LEN=0x8000
CONFIG_SYS_MALLOC_LEN=0x30000
CONFIG_SYS_BOOTM_LEN=0x20000000
CONFIG_ENV_SIZE=0x2000
CONFIG_ENV_OFFSET=0x5000
CONFIG_NR_DRAM_BANKS=2
CONFIG_COUNTER_FREQUENCY=800000000
CONFIG_ARMV8_MULTIENTRY=y
CONFIG_ARMV8_SET_SMPEN=y
CONFIG_ARMV8_SPIN_TABLE=y
CONFIG_SYS_CUSTOM_LDSCRIPT=y
CONFIG_SYS_LDSCRIPT="board/axiado/mk/u-boot.lds"
CONFIG_FIT=y
CONFIG_OF_BOARD_SETUP=y
CONFIG_USE_PREBOOT=y
CONFIG_DEFAULT_FDT_FILE="mk.dtb"
# CONFIG_DISPLAY_CPUINFO is not set
CONFIG_HUSH_PARSER=y
CONFIG_SYS_PROMPT="Axiado> "
CONFIG_AUTOBOOT_KEYED=n
CONFIG_AUTOBOOT_PROMPT="Press \"<Esc><Esc>\" to stop autobooting in %d seconds\n"
CONFIG_AUTOBOOT_STOP_STR="\x1b\x1b"
CONFIG_USE_BOOTARGS=n
CONFIG_USE_BOOTCOMMAND=n
CONFIG_SYS_VENDOR="axiado"
CONFIG_SYS_BOARD="mk"
CONFIG_SYS_CONFIG_NAME="mk"
CONFIG_MISC_INIT_R=y
CONFIG_SYS_ALT_MEMTEST=y
CONFIG_OF_CONTROL=y
CONFIG_OF_SEPARATE=y
CONFIG_DEFAULT_DEVICE_TREE="mk"
CONFIG_MULTI_DTB_FIT=y
CONFIG_CLK=y
CONFIG_LZMA=y
CONFIG_XZ=y
CONFIG_ZYNQ_SERIAL=y

# CONFIG_AUTO_COMPLETE is not set
# CONFIG_SYS_LONGHELP is not set
# CONFIG_TOOLS_MKEFICAPSULE is not set

CONFIG_CMD_GO=y

CONFIG_LOG=y
CONFIG_LOGLEVEL=3
